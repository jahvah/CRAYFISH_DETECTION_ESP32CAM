void sendTelegram(String message) {
  if (millis() - lastTelegramSent < TELEGRAM_COOLDOWN) {
    Serial.println("Telegram cooldown active...");
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected, cannot send Telegram");
    return;
  }

  String url = "https://api.telegram.org/bot" + botToken + "/sendMessage?chat_id=" + chatID + "&text=" + message;
  HTTPClient http;
  http.begin(url);
  int httpCode = http.GET();
  if (httpCode > 0) {
    Serial.println("Telegram message sent! Code: " + String(httpCode));
  } else {
    Serial.println("Telegram send failed: " + http.errorToString(httpCode));
  }
  http.end();

  lastTelegramSent = millis();
}

