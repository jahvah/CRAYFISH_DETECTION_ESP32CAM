  return eggStatus;
}

// ================= SEND PHOTO =================
void sendPhotoToServer() {
  camera_fb_t* fb = esp_camera_fb_get();
  if (!fb) return;

  HTTPClient http;
  http.begin(cameraUploadUrl);
  http.addHeader("Content-Type", "image/jpeg");
  http.POST(fb->buf, fb->len);
  http.end();
  esp_camera_fb_return(fb);
}

// ================= SERVO =================
void startServo(String sizeCategory) {
  servoActive = true;
  servoStartTime = millis();
  if (sizeCategory == "SMALL") servoDuration = SMALL_DURATION;
  else if (sizeCategory == "BIG") servoDuration = BIG_DURATION;
  else servoDuration = 1000;
  servoMotor.write(SERVO_OPEN);
}

void updateServo() {
  if (servoActive && millis() - servoStartTime >= servoDuration) {
    servoMotor.write(SERVO_CLOSE);
    servoActive = false;
    lastServoAction = millis();
  }
}

// ================= PH =================
void readPH() {
  long sum = 0;
  for(int i=0; i<50; i++) sum += analogRead(PH_PIN);
  int rawPh = sum / 50;
  float ph = (pH_slope * rawPh) + pH_intercept;

  String pumpState = digitalRead(PUMP_PIN) == LOW ? "ON" : "OFF"; // active LOW relay

  // ----- WATER STATE -----
  String waterState = "ok";

  if(ph < PH_LOW){
    waterState = "Acidic";
  }
  else if(ph > PH_HIGH){
    waterState = "Basic";
  }
  else{
    waterState = "Neutral";
  }

  // ----- PUMP CONTROL -----
  if(ph < PH_LOW && !pumpRunning && millis() - lastPumpTime >= PUMP_COOLDOWN_MS) {
    digitalWrite(PUMP_PIN, LOW);  // ON
    pumpRunning = true;
    pumpStartTime = millis();
    Serial.println("Pump STARTED via relay");
  }

  if(pumpRunning && millis() - pumpStartTime >= DOSING_TIME) {
    digitalWrite(PUMP_PIN, HIGH); // OFF
    pumpRunning = false;
    lastPumpTime = millis();
    Serial.println("Pump STOPPED via relay");
  }

  Serial.println("pH: " + String(ph,2) + 
                 " | Raw: " + String(rawPh) + 
                 " | Water: " + waterState +
                 " | Pump: " + pumpState);

  // ----- SEND TO SERVER -----
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    String url = String("http://") + serverIP + ":" + serverPort + "/api/ph";
    http.begin(url);
    http.addHeader("Content-Type", "application/json");

    String payload = "{\"ph\":" + String(ph,2) +
                     ",\"raw\":" + String(rawPh) +
                     ",\"water_state\":/" + waterState +
                     "\",\"pump_state\":/" + pumpState + "\"}";

    http.POST(payload);
    http.end();
  }
}

// ================= SETUP =================
void setup() {

  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, HIGH); // OFF (active LOW)
  Serial.begin(115200);
  delay(2000);

  initCamera();

  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  pH_slope = (PH_ACID - PH_NEUTRAL) / (float)(RAW_ACID - RAW_NEUTRAL);
  pH_intercept = PH_NEUTRAL - (pH_slope * RAW_NEUTRAL);
  Serial.println("pH Calibration Ready");

  ESP32PWM::allocateTimer(1);
  servoMotor.setPeriodHertz(50);
  servoMotor.attach(servoPin, 1000, 2000);
  servoMotor.write(SERVO_CLOSE);

  connectToWiFi();
}

// ================= LOOP =================
void loop() {
  unsigned long now = millis();

  if (WiFi.status() != WL_CONNECTED) connectToWiFi();

  // Camera capture
  if (now - lastCameraCapture >= CAMERA_INTERVAL) {
    lastCameraCapture = now;
    sendPhotoToServer();
    Serial.println("Photo sent to server");
  }

  // Poll detection
  if (now - lastDetectPoll >= DETECT_INTERVAL) {
    lastDetectPoll = now;
    String sizeCategory = getDetectionFromServer();
    String eggStatus = getEggDetectionFromServer();
    Serial.println("Size: " + sizeCategory + " | Egg: " + eggStatus);

    if (sizeCategory != "" && !servoActive) startServo(sizeCategory);
    if (eggStatus == "detected") sendTelegram("⚠️ Egg Detected in Crayfish Tank!");
  }

  updateServo();
  readPH();
}
