// ================= SERVER DETECTION =================
String getDetectionFromServer() {
  HTTPClient http;
  String url = String("http://") + serverIP + ":" + serverPort + "/api/detect";
  http.begin(url);
  int httpCode = http.GET();
  String sizeCategory = "";
  if (httpCode == HTTP_CODE_OK) {
    String response = http.getString();
    int idx = response.indexOf("\"size_category\"");
    if (idx != -1) {
      int colon = response.indexOf(":", idx);
      int q1 = response.indexOf("\"", colon + 1);
      int q2 = response.indexOf("\"", q1 + 1);
      sizeCategory = response.substring(q1 + 1, q2);
    }
  }
  http.end();
  return sizeCategory;
}

String getEggDetectionFromServer() {
  HTTPClient http;
  String url = String("http://") + serverIP + ":" + serverPort + "/api/detect_eggs";
  http.begin(url);
  int httpCode = http.GET();
  String eggStatus = "";
  if (httpCode == HTTP_CODE_OK) {
    String response = http.getString();
    int idx = response.indexOf("\"status\"");
    if (idx != -1) {
      int colon = response.indexOf(":", idx);
      int q1 = response.indexOf("\"", colon + 1);
      int q2 = response.indexOf("\"", q1 + 1);
      eggStatus = response.substring(q1 + 1, q2);
    }
  }
  http.end();
  return eggStatus;
}

// ================= CAMERA SEND =================
void sendPhotoToServer() {
  camera_fb_t * fb = esp_camera_fb_get();
  if (!fb) {
    Serial.println("Camera capture failed");
    return;
  }
  HTTPClient http;
  http.begin(cameraUploadUrl);
  http.addHeader("Content-Type", "image/jpeg");
  int response = http.POST(fb->buf, fb->len);
  if (response == 200) {
    Serial.println("Image sent");
  }
  http.end();
  esp_camera_fb_return(fb);
}

// ================= SERVO =================
void controlServoForSize(String sizeCategory) {
  int duration = 0;
  if (sizeCategory == "SMALL") duration = SMALL_DURATION;
  if (sizeCategory == "BIG") duration = BIG_DURATION;
  servoMotor.write(SERVO_OPEN);
  delay(1000);
  delay(duration);
  servoMotor.write(SERVO_CLOSE);
  delay(1000);
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);
  delay(2000);

  // PH INIT
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);
  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);
  pH_slope = (PH_NEUTRAL - PH_ACID) / (float)(RAW_NEUTRAL - RAW_ACID);
  pH_intercept = PH_NEUTRAL - (pH_slope * RAW_NEUTRAL);

  initCamera();

  ESP32PWM::allocateTimer(1);
  servoMotor.setPeriodHertz(50);
  servoMotor.attach(servoPin, 1000, 2000);
  servoMotor.write(SERVO_CLOSE);

  connectToWiFi();
}

// ================= LOOP =================
void loop() {
  unsigned long now = millis();

  // ---------- CAMERA CAPTURE ----------
  if (now - lastCameraCapture >= CAMERA_INTERVAL) {
    sendPhotoToServer();
    lastCameraCapture = now;
  }

  // ---------- POLL DETECTIONS ----------
  if (WiFi.status() == WL_CONNECTED && now - lastDetectPoll >= DETECT_INTERVAL) {
    lastDetectPoll = now;

    String sizeCategory = getDetectionFromServer(); // Crayfish
    String eggStatus = getEggDetectionFromServer(); // Eggs

    // ---------- SERVO ----------
    if (sizeCategory != "" && now - lastServoAction >= CAMERA_INTERVAL) {
      Serial.println("Crayfish detected: " + sizeCategory);
      controlServoForSize(sizeCategory);
      lastServoAction = millis();
    }

    // ---------- TELEGRAM FOR EGGS ----------
    if (eggStatus == "detected") {
      sendTelegram("⚠️ Egg Detected in Crayfish Tank!");
    }
  }

  delay(5);
}
