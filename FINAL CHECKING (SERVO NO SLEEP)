// ================= PH SENSOR =================
#define PH_PIN 2
#define PUMP_PIN 21
#define PH_LOW 6.5
#define PH_HIGH 7.5
#define DOSING_TIME 30000
const unsigned long PUMP_COOLDOWN_MS = 30000;

int RAW_NEUTRAL = 2095;
float PH_NEUTRAL = 7.0;
int RAW_ACID = 2450;
float PH_ACID = 4.0;
float pH_slope;
float pH_intercept;

bool pumpRunning = false;
unsigned long pumpStartTime = 0;
unsigned long lastPumpTime = 0;

// ================= CAMERA =================
unsigned long lastCameraCapture = 0;
const int CAMERA_INTERVAL = 5000;

// ================= DETECTION =================
unsigned long lastDetectPoll = 0;

const int DETECT_INTERVAL = 5000;

// ================= SERVO =================
unsigned long lastServoAction = 0;
bool servoActive = false;
unsigned long servoStartTime = 0;
unsigned long servoDuration = 0;

// ================= CAMERA INIT =================
void initCamera() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;

  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;

  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;

  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;

  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  config.xclk_freq_hz = 20000000;
  config.frame_size = FRAMESIZE_VGA;
  config.pixel_format = PIXFORMAT_JPEG;
  config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
  config.fb_location = CAMERA_FB_IN_PSRAM;
  config.jpeg_quality = 12;
  config.fb_count = 1;

  if (!psramFound()) config.fb_location = CAMERA_FB_IN_DRAM;

  if (esp_camera_init(&config) != ESP_OK) {
    Serial.println("Camera init failed");
    delay(5000);
    ESP.restart();
  }
  Serial.println("Camera init OK");
}

// ================= WIFI =================
void connectToWiFi() {
  Serial.println("Connecting to WiFi...");
  WiFi.begin(ssid, password);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("WiFi Connected! IP: " + WiFi.localIP().toString());
  } else Serial.println("WiFi FAILED");
}

// ================= SERVER DETECTION =================
String getDetectionFromServer() {
  HTTPClient http;
  String url = String("http://") + serverIP + ":" + serverPort + "/api/detect";
  http.begin(url);
  int httpCode = http.GET();
  String sizeCategory = "";
  if (httpCode == HTTP_CODE_OK) {
    String response = http.getString();
    int idx = response.indexOf("\"size_category\"");
    if (idx != -1) {
      int colon = response.indexOf(":", idx);
      int q1 = response.indexOf("\"", colon + 1);
      int q2 = response.indexOf("\"", q1 + 1);
      sizeCategory = response.substring(q1 + 1, q2);
    }
  }
  http.end();
  return sizeCategory;
}

String getEggDetectionFromServer() {
  HTTPClient http;
  String url = String("http://") + serverIP + ":" + serverPort + "/api/detect_eggs";
  http.begin(url);
  int httpCode = http.GET();
  String eggStatus = "";
  if (httpCode == HTTP_CODE_OK) {
    String response = http.getString();
    int idx = response.indexOf("\"status\"");
    if (idx != -1) {
      int colon = response.indexOf(":", idx);
      int q1 = response.indexOf("\"", colon + 1);
      int q2 = response.indexOf("\"", q1 + 1);
      eggStatus = response.substring(q1 + 1, q2);
